# ---------------------------------------------------------------------------
# Email notifications for the contact form (optional)
#
# Without a key, nothing is sent — the server just logs what it would have
# sent. The form still works; you'd only see the inquiry in the server logs.
#
# Setup:
#   1. Sign up free at https://resend.com (3,000 emails/month, no card)
#   2. API Keys -> create one -> paste below
#   3. Send yourself a test message from the contact form to check it arrives
#
# IMPORTANT about MAIL_FROM: until you verify a domain in Resend, mail can
# only be sent FROM onboarding@resend.dev, and Resend will only deliver it TO
# the email address that owns your Resend account. That is enough to test
# with your own inbox as the destination.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
MAIL_FROM=
